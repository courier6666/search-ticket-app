@model OnSaleTicketResult

@{
    var httpContext = ViewContext.HttpContext;
    var returnUrl = $"{httpContext.Request.Scheme}://{httpContext.Request.Host}{httpContext.Request.PathBase}{httpContext.Request.Path}{httpContext.Request.QueryString}";

}

<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <!-- Ticket Title -->
        <h5 class="card-title">@Model.Title</h5>

        <!-- Travel Info -->
        <p class="card-text mb-1">
            <strong>From:</strong> @Model.Origin.Settlement
            (@Model.Origin.Latitude, @Model.Origin.Longitude)
        </p>
        <p class="card-text mb-1">
            <strong>To:</strong> @Model.Destination.Settlement
            (@Model.Destination.Latitude, @Model.Destination.Longitude)
        </p>
        <p class="card-text mb-1">
            <strong>Transportation:</strong> @Model.TravelTransportationType
        </p>

        <!-- Departure / Arrival Times -->
        @if (Model.UserLocalTimeZone != null)
        {
            <h6 class="card-text mb-1"><strong>Your timezone</strong></h6>
            <div>
                <strong>(@Model.UserLocalTimeZone)</strong>
            </div>
            <p class="card-text mb-1">
                <div>
                    <strong>Departure:</strong> @Model.DepartureTimeUser!.Value.ToString("g")
                </div>

            </p>
            <p class="card-text mb-3">
                <div>
                    <strong>Arrival:</strong> @Model.ArrivalTimeUser!.Value.ToString("g")
                </div>
            </p>
        }

        <h6 class="card-text mb-1"><strong>Local Timezone</strong></h6>
        <div>
            <strong>(@Model.DepartureLocalTimeZone)</strong>
        </div>
        <p class="card-text mb-1">

            <div>
                <strong>Departure:</strong> @Model.DepartureTimeLocal.ToString("g")
            </div>

        </p>
        <p class="card-text mb-3">
            <div>
                <strong>Arrival:</strong> @Model.ArrivalTimeLocal.ToString("g")
            </div>
        </p>

        <h6 class="card-text mb-1"><strong>UTC</strong></h6>
        <p class="card-text mb-1">
            <div>
                <strong>Departure:</strong> @Model.DepartureTimeUtc.ToString("g")
            </div>

        </p>
        <p class="card-text mb-3">
            <div>
                <strong>Arrival:</strong> @Model.ArrivalTimeUtc.ToString("g")
            </div>
        </p>

        @if (Model.DistanceFromUserKm != null)
        {
            <p class="card-text mb-3">
                <span class="fw-bold"><i class="fa-solid fa-location-dot"></i> <span>@Model.DistanceFromUserKm!.Value.ToString("F2")</span> km from you.</span>
            </p>
        }

        <!-- Price and Stats -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-bold">Price: $@Model.Price</span>
            <span class="fw-bold">
                <i class="fa-solid fa-eye"></i> @Model.ViewsCount
                <i class="fa-solid fa-cart-arrow-down"></i> @Model.PurchaseCount
            </span>
        </div>

        <div class="d-flex justify-content-start gap-1">
            @if (Model.IsBought)
            {
                <button class="btn btn-secondary" disabled>Already Bought</button>
            }
            else
            {
                <form method="post" asp-controller="OnSaleTicket" asp-action="Purchase" class="d-inline">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Buy Ticket</button>
                </form>
            }
            <a class="btn btn-primary" asp-controller="OnSaleTicket" asp-action="Detail" asp-route-onSaleTicketId="@Model.Id" asp-route-returnUrl="@returnUrl">View</a>
        </div>
    </div>
</div>