@model LoginCommand

<h3 class="text-start">Log In</h3>
<div class="row text-center">
    <div class="col-md-6">
        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-4">
                <label asp-for="@Model.Email" name="Email">Email</label>
                <span asp-validation-for="@Model.Email"></span>
                <input asp-for="@Model.Email" name="Email" class="form-control" placeholder="Email" />
            </div>
            <div class="mb-4">
                <label asp-for="@Model.Password" name="Password">Password</label>
                <span asp-validation-for="@Model.Password"></span>
                <input asp-for="@Model.Password" name="Password" class="form-control" placeholder="Password" />
            </div>
            <div asp-validation-summary="All" class="mb-4"></div>
            <div class="mt-4 d-flex gap-1 justify-content-between">
                <button type="reset" class="btn btn-secondary">Clear</button>
                <button type="submit" class="btn btn-primary">Log In</button>
            </div>
        </form>
    </div>
</div>