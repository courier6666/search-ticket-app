@model RegisterCommand


<div class="row justify-content-md-center">
    <h3 class="text-center">Register</h3>
    <div class="col-md-6">
        <form asp-controller="Account" asp-action="Register" method="post">
            <div class="mb-4">
                <label asp-for="@Model.Email" name="Email">Email</label>
                <span asp-validation-for="@Model.Email"></span>
                <input asp-for="@Model.Email" name="Email" class="form-control" placeholder="Email"/>
            </div>
            <div class="mb-4">
                <label asp-for="@Model.Password">Password</label>
                <span asp-validation-for="@Model.Password"></span>
                <input asp-for="@Model.Password" class="form-control" placeholder="Password"/>
            </div>
            <div class="mb-4">
                <label asp-for="@Model.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="@Model.ConfirmPassword"></span>
                <input asp-for="@Model.ConfirmPassword" class="form-control" placeholder="Password"/>
            </div>
            <div asp-validation-summary="All" class="mb-4"></div>
            <div class="mt-4 d-flex gap-1 justify-content-between">
                <button type="reset" class="btn btn-secondary">Clear</button>
                <button type="submit" class="btn btn-primary">Log In</button>
            </div>
        </form>
    </div>
</div>