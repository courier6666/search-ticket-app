@model TicketSearchViewModel

@{
    var query = Model.Query;
    var queryParams = new Dictionary<string, string?>();

    if (!string.IsNullOrWhiteSpace(query.Title))
        queryParams["query.title"] = query.Title;

    if (!string.IsNullOrWhiteSpace(query.Settlement))
        queryParams["query.settlement"] = query.Settlement;

    if (query.PriceLower != null)
        queryParams["query.priceLower"] = query.PriceLower.ToString();

    if (query.PriceUpper != null)
        queryParams["query.priceUpper"] = query.PriceUpper.ToString();

    if (query.TravelTransportationType != null)
        queryParams["query.travelTransportationType"] = query.TravelTransportationType.ToString();
}

<div class="row justify-content-md-center">
    <div class="col-3">
        <form asp-action="Search" method="get" class="border p-3 rounded">
            <h5>Search Tickets</h5>

            <div class="mb-3">
                <label asp-for="Query.Title" class="form-label">Title</label>
                <input asp-for="Query.Title" class="form-control" placeholder="Enter title" />
            </div>

            <div class="mb-3">
                <label asp-for="Query.Settlement" class="form-label">Settlement</label>
                <input asp-for="Query.Settlement" class="form-control" placeholder="Enter settlement" />
            </div>

            <div class="mb-3">
                <label asp-for="Query.PriceLower" class="form-label">Min Price</label>
                <input asp-for="Query.PriceLower" type="number" step="0.01" class="form-control" placeholder="0" />
            </div>

            <div class="mb-3">
                <label asp-for="Query.PriceUpper" class="form-label">Max Price</label>
                <input asp-for="Query.PriceUpper" type="number" step="0.01" class="form-control" placeholder="1000" />
            </div>

            <div class="mb-3">
                <label asp-for="Query.TravelTransportationType" class="form-label">Transportation Type</label>
                <select asp-for="Query.TravelTransportationType" class="form-select">
                    <option value="">Any</option>
                    <option value="Bus">Bus</option>
                    <option value="Train">Train</option>
                    <option value="Plane">Plane</option>
                    <!-- Add other types as needed -->
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Search</button>
        </form>
    </div>
    <div class="col-9">
        @if (Model.Tickets.TotalCount > 0)
        {
            <h4 class="mb-4 fw-bold">Found tickets: <span>@Model.Tickets.TotalCount</span></h4>
            @foreach (var item in Model.Tickets.Items)
            {
                <div class="mb-3">
                    <partial name="Partial/_OnSaleTicketPreview" model="item" />
                </div>
            }
        }
        else
        {
            <h4 class="mb-4 fw-bold">No tickets found.</h4>
        }
        
        <partial name="Partial/_PagingLinksPartial"
                 model="@(Model.Tickets.HasPrevious,
                        Model.Tickets.HasNext,
                        Model.Tickets.Page,
                        Model.Tickets.TotalPages,
                        Model.Tickets.TotalCount,
                        "OnSaleTicket",
                        "Search",
                        queryParams)" />
    </div>
</div>